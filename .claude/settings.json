{
  "permissions": {
    "allow": [
      "Bash(./bin/e2eat:*)",
      "Bash(docker:*)",
      "Bash(git clone:*)",
      "Bash(git -C:*)",
      "Bash(gh api:*)",
      "Bash(gh auth status:*)",
      "Bash(curl:*)",
      "Bash(uv run --project tools:*)",
      "WebSearch"
    ],
    "deny": [
      "Read(**/secrets.env)",
      "Read(**/.secrets.env)",
      "Read(./secrets.env)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(bun:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(pipx:*)",
      "Bash(poetry:*)",
      "Bash(python -m pip:*)",
      "Bash(python3 -m pip:*)",
      "Bash(cargo:*)",
      "Bash(go build:*)",
      "Bash(go run:*)",
      "Bash(go test:*)",
      "Bash(mvn:*)",
      "Bash(gradle:*)",
      "Bash(bundle:*)",
      "Bash(make:*)",
      "Bash(composer:*)",
      "Bash(dotnet:*)",
      "Bash(uvx:*)",
      "Bash(uv pip:*)",
      "Bash(node:*)",
      "Bash(deno:*)",
      "Bash(./gradlew:*)",
      "Bash(./mvnw:*)",
      "Bash(rake:*)",
      "Bash(tox:*)",
      "Bash(pytest:*)",
      "Bash(python3 runs/:*)",
      "Bash(python runs/:*)",
      "Bash(bash runs/:*)",
      "Bash(sh runs/:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/e2eat guard"
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/e2eat guard"
          }
        ]
      }
    ]
  }
}
