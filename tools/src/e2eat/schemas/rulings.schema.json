{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rulings",
  "type": "object",
  "required": ["rulings"],
  "properties": {
    "rulings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "ruling", "reason"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^F-[a-z0-9-]+-[0-9]{3}$"},
          "ruling": {"enum": ["confirmed", "dropped"]},
          "reason": {"type": "string", "minLength": 3}
        }
      }
    }
  }
}
