{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runtime",
  "type": "object",
  "required": [
    "status",
    "strategy_used",
    "base_urls",
    "internal_urls",
    "exec_container",
    "containers",
    "network",
    "health",
    "logs"
  ],
  "properties": {
    "status": {
      "enum": [
        "running",
        "failed",
        "static-only"
      ]
    },
    "strategy_used": {
      "enum": [
        "repo-docker",
        "generated-dockerfile",
        "toolchain-image",
        "none"
      ]
    },
    "base_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^http://(127\\.0\\.0\\.1|localhost):[0-9]+"
      }
    },
    "internal_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exec_container": {
      "type": [
        "string",
        "null"
      ]
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "network": {
      "type": [
        "string",
        "null"
      ]
    },
    "health": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        }
      }
    },
    "startup_secs": {
      "type": [
        "number",
        "null"
      ]
    },
    "image_size_mb": {
      "type": [
        "number",
        "null"
      ]
    },
    "idle_mem_mb": {
      "type": [
        "number",
        "null"
      ]
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "functional",
          "security",
          "performance",
          "reliability",
          "maintainability",
          "operability",
          "compliance",
          "viability"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "planned",
          "run"
        ],
        "properties": {
          "planned": {
            "type": "integer",
            "minimum": 0
          },
          "run": {
            "type": "integer",
            "minimum": 0
          },
          "blocked": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "untested": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "why"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}
